# SOAR Playbook — .gitignore

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.mypy_cache/
.ruff_cache/
.pytest_cache/
env/
venv/
.venv/
*.egg-info/
dist/
build/
node_modules/
*.tsbuildinfo
.vite/
dashboard/test-results/
dashboard/playwright-report/

# Output / reports
output/
*.pdf
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo
.cursor/
.gemini/

# Test coverage
.coverage
htmlcov/

# Local environment secrets
.env
.env.local
.env.*
!.env.example

# Local IDE/runtime metadata accidentally added before ignore rules were in place
.cursor/
.gemini/

# Internal pentest artifacts and analyst-only reports
docs/pentest-report-*.md
docs/reports/dashboard-pentest-*.md

# Local databases
*.db
*.sqlite
*.sqlite3

# Keys / certificates / secret blobs
*.pem
*.key
*.crt
*.p12
*.pfx
*.token
*.secrets*

# OS
.DS_Store
Thumbs.db
