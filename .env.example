# Default runtime persistence target.
# Use the direct or Supavisor session Postgres string from the Supabase dashboard.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Optional explicit overrides if you want separate targets per subsystem.
SOAR_DATABASE_URL=
SOAR_A2A_DB_URL=

# Threat-intel provider selection.
# Use "virustotal" for live hash enrichment, or leave empty / use a mock-safe mode in local tests.
SOAR_INTEL_PROVIDER=virustotal
VIRUSTOTAL_API_KEY=

# FastAPI CORS configuration for local dashboard development.
SOAR_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Bearer tokens used by protected API routes.
# The React dashboard expects an operator principal with both incident_process and incident_read.
SOAR_AUTH_TOKENS_JSON={"tokens":[{"token":"incident-operator-token","principal_id":"incident-operator","principal_type":"user","roles":["incident_process","incident_read"],"workspaces":["*"]}]}

# Local Vite proxy settings used by dashboard/vite.config.ts.
SOAR_API_PROXY_TARGET=http://127.0.0.1:8000
SOAR_API_PROXY_TOKEN=incident-operator-token

# Optional frontend runtime value when you are not using the local Vite proxy.
VITE_SOAR_API_BASE_URL=

# Optional public Supabase values for future frontend-only experiments.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
