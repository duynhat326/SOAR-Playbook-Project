SOAR_ENVIRONMENT=staging
SOAR_DB_TARGET=
SOAR_DATABASE_URL=postgresql://soar_staging:<password>@postgres-staging.internal:5432/soar
SOAR_SQLITE_FALLBACK_PATH=/app/output/soar-staging-fallback.db
SOAR_SOURCE_PROVIDER=wazuh
SOAR_ACTION_PROVIDER=local
SOAR_TICKETING_CONNECTOR=local
SOAR_TICKETING_PROVIDER=webhook
SOAR_TICKETING_WEBHOOK_URL=https://tickets-staging.example.com/api/soar
SOAR_TICKETING_WEBHOOK_TOKEN=<set-me>
SOAR_ASSET_PROVIDER=http
SOAR_ASSET_API_URL=https://cmdb-staging.example.com/api
SOAR_ASSET_API_TOKEN=<set-me>
SOAR_INTEL_PROVIDER=virustotal
VIRUSTOTAL_API_KEY=<set-me>
SOAR_API_CORS_ORIGINS=https://soar-staging.example.com
SOAR_AUTH_TOKENS_JSON={"tokens":[{"token":"<set-me>","principal_id":"incident-operator","principal_type":"user","roles":["incident_process","incident_read"],"workspaces":["*"]}]}
SOAR_API_PROXY_TARGET=https://api-staging.example.com
VITE_SOAR_API_BASE_URL=/soar-api
