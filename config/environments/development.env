SOAR_ENVIRONMENT=development
SOAR_DB_TARGET=/app/output/soar-local.db
SOAR_SQLITE_FALLBACK_PATH=/app/output/soar-local.db
SOAR_SOURCE_PROVIDER=passthrough
SOAR_ACTION_PROVIDER=local
SOAR_TICKETING_CONNECTOR=local
SOAR_TICKETING_PROVIDER=json
SOAR_ASSET_PROVIDER=mock
SOAR_INTEL_PROVIDER=mock
SOAR_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
SOAR_AUTH_TOKENS_JSON={"tokens":[{"token":"dev-incident-operator-token","principal_id":"incident-operator","principal_type":"user","roles":["incident_process","incident_read"],"workspaces":["*"]}]}
SOAR_API_PROXY_TARGET=http://api:8000
VITE_SOAR_API_BASE_URL=/soar-api
